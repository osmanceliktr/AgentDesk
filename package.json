{
  "name": "ai-cli-agent",
  "version": "1.0.0",
  "description": "Claude Agent SDK üzerinden komut verebileceğiniz Electron masaüstü uygulaması",
  "author": "osmanceliktr",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:nsis": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@openai/codex-sdk": "^0.146.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.osmanceliktr.aicliagent",
    "productName": "AI CLI Agent",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "**/node_modules/@openai/codex*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
